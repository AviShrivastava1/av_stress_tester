    "/scenarios/{scenario_id}/trajectories": {
      "get": {
        "summary": "Get Trajectories",
        "description": "Every agent's logged path for one scenario.\n\n404 only when the scenario itself is unknown — checked against scenario_scores,\nbecause \"this scenario exists but its geometry has not been exported yet\" is a\nnormal state that must not look like a missing scenario. That case returns 200\nwith an empty agents list.\n\nST_AsGeoJSON does the geometry-to-JSON conversion inside PostgreSQL: less data\non the wire than WKT, no geometry library needed in the API process, and the\nresult drops straight into a deck.gl PathLayer.\n\nBUT GeoJSON has no M dimension, and ST_AsGeoJSON silently DROPS it —\n`LINESTRING M(1 2 0, 3 4 1)` comes back as `[[1,2],[3,4]]` with the measures\ngone. Since M is what tells the frontend which timestep each vertex belongs to,\nit is fetched alongside with ST_DumpPoints + ST_M, ordered by vertex position\nso it stays index-aligned with the coordinates.",
        "operationId": "get_trajectories_scenarios__scenario_id__trajectories_get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrajectoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios/{scenario_id}/perturbed": {
      "get": {
        "summary": "Get Perturbed",
        "description": "The challenger's logged path next to its minimally-perturbed one — the Phase 4\nresult, made drawable.\n\n404 ONLY when the scenario is unknown. A scenario that exists but has not been\nstress-tested returns 200 with null paths: \"nothing to show yet\" is a normal\nstate in a pipeline whose expensive pass runs over a chosen subset, and a\nfrontend should render an empty panel for it, not an error.",
        "operationId": "get_perturbed_scenarios__scenario_id__perturbed_get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerturbedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
