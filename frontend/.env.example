# Base URL of the FastAPI backend (src/api/main.py). Defaults to
# http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# Offers the "Request a search" form on the scenario page. OFF unless this is exactly `true`, and the API must be switched on
# too (DEPLOY.md, "Queued search requests"). Leave it unset.
# VITE_SEARCH_REQUESTS=true
